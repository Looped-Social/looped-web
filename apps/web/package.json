{
  "name": "@looped/web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "build:staging": "react-router build --mode staging",
    "dev": "react-router dev",
    "dev:staging": "react-router dev --mode staging",
    "lint": "eslint \"{app,src}/**/*.{ts,tsx}\"",
    "test:contracts": "node --test --experimental-strip-types \"src/lib/**/*.test.ts\"",
    "format": "prettier --write \"{app,src,public}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"{app,src,public}/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@looped/config": "file:../../packages/config",
    "@looped/ui": "file:../../packages/ui",
    "@react-router/node": "^7.12.0",
    "@react-router/serve": "^7.12.0",
    "firebase": "^11.0.0",
    "isbot": "^5.1.31",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-icons": "^5.5.0",
    "react-router": "^7.12.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.25.6",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "^7.12.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^22",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.0-canary-ab18f33d-20260220",
    "globals": "^15.12.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.56.1-alpha.3",
    "vite": "^7.1.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
