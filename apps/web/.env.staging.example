# Staging environment variables for local development.
#
# Usage:
# 1) Copy to `.env.staging.local` (recommended) and fill values.
# 2) Run: `npm run dev:staging` (from repo root) or `npm run dev:staging -w apps/web`.
#
# Firebase web auth configuration (required for login/delete account).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Base URL for user API requests.
VITE_API_BASE_URL=

# Set to "true" to force a site-wide 404 response.
VITE_FORCE_NOT_FOUND=false

