{
  "rewrites": [
    {
      "source": "/.well-known/apple-app-site-association",
      "destination": "/api/apple-app-site-association"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mylooped.app" }],
      "destination": "https://mylooped.app/:path*",
      "permanent": true
    }
  ]
}
