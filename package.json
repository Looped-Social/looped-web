{
  "name": "looped-web",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run -w apps/web dev",
    "dev:staging": "npm run -w apps/web dev:staging",
    "build": "npm run -w apps/web build",
    "build:staging": "npm run -w apps/web build:staging",
    "start": "npm run -w apps/web start",
    "typecheck": "npm run --ws --if-present typecheck",
    "lint": "npm run --ws --if-present lint",
    "format": "prettier --write \"apps/**/{app,src,public}/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"apps/**/{app,src,public}/**/*.{ts,tsx,js,jsx,json,css,md}\" \"packages/**/src/**/*.{ts,tsx,css}\""
  }
}
